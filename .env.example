# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in what you need.
#
# EVERY VARIABLE IS OPTIONAL. The site builds and deploys with this file empty —
# each integration degrades to a documented, honest fallback rather than failing.
# `lib/env.server.ts` has a `describeIntegrations()` helper that reports which are
# live and what the consequence of each absence is.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle. Never put a
# secret behind that prefix.
# ---------------------------------------------------------------------------

# --- Canonical origin ------------------------------------------------------
# Set this on the first deploy. Without it, canonical URLs, OpenGraph images and
# the sitemap fall back to VERCEL_URL, then to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ===========================================================================
# CONTACT
# ===========================================================================

# --- Resend (server-side, preferred) ---------------------------------------
# The credential never reaches the browser and the submission is rate limited.
# Both RESEND_API_KEY and CONTACT_TO_EMAIL are required together — a key with no
# recipient has nowhere to deliver.
# Absent: /api/contact returns 501 and the client falls through to EmailJS.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a verified sender on your Resend domain. Falls back to Resend's
# onboarding address, which works for testing only.
CONTACT_FROM_EMAIL=

# --- EmailJS (client-side fallback) ----------------------------------------
# The public key is public by design. Configure rate limiting and domain
# allow-listing in the EmailJS dashboard — that is where the protection belongs.
# Absent: the form renders the composed message with a copy button and a mailto.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Calendly --------------------------------------------------------------
# e.g. https://calendly.com/your-handle/30min
# Absent: the booking panel offers a pre-filled mailto instead of an embed.
# Present: the embed is click-to-load, so no third-party script loads until asked.
NEXT_PUBLIC_CALENDLY_URL=


# ===========================================================================
# GITHUB
# ===========================================================================

# Absent: the dashboard renders an explanatory panel. Nothing is faked.
# A fine-grained token with read-only public_repo raises the rate limit from
# 60 to 5,000 requests an hour.
GITHUB_USERNAME=
GITHUB_TOKEN=


# ===========================================================================
# NEWSLETTER
# ===========================================================================

# Absent: subscriptions validate and report `pending: true` rather than claiming
# a delivery that did not happen. Wire the provider call in
# services/newsletter.service.ts — the TODO block marks the exact spot.
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=


# ===========================================================================
# AI ASSISTANT
# ===========================================================================

# The assistant runs on a local structured knowledge base and needs no key.
# These are the seam for the LLM migration: set a provider key, flip
# NEXT_PUBLIC_CHAT_REMOTE to true, and /api/chat streams from the model instead.
# RemoteChatEngine already speaks the route's NDJSON protocol.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NEXT_PUBLIC_CHAT_REMOTE=false


# ===========================================================================
# ANALYTICS
# ===========================================================================

# Master gate. Defaults to on in production, off locally.
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Vercel Analytics and Speed Insights need no key on Vercel and set no cookie.
# They are the only providers enabled by default.

# --- Cookie-free, no consent banner required -------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: proxy through your own domain to survive blockers.
NEXT_PUBLIC_PLAUSIBLE_HOST=
NEXT_PUBLIC_CLARITY_ID=

# --- Require a consent gate before enabling in the EU ----------------------
# analyticsConfig.requiresConsent reports true when either of these is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ===========================================================================
# PWA
# ===========================================================================

# Service worker registration. Defaults to on in production, off in development —
# a cached shell against a hot-reloading dev server is miserable to debug.
NEXT_PUBLIC_ENABLE_PWA=true


# ===========================================================================
# SEARCH CONSOLE
# ===========================================================================

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ===========================================================================
# INJECTED BY VERCEL — do not set these yourself
# ===========================================================================
# VERCEL_URL      — fallback canonical origin on preview deployments
# VERCEL_ENV      — "production" | "preview" | "development"; preview deployments
#                   are disallowed wholesale in robots.txt
